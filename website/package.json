{
  "name": "spacekonceptrental-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-production-build-provenance.cjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sharp-native": "node scripts/validate-sharp-native.cjs",
    "test:sharp-native-lifecycle": "node --test scripts/test-sharp-native-lifecycle.cjs",
    "test:production-audit-remediation": "node --test scripts/test-production-audit-remediation.cjs",
    "test:production-audit-upload-admission": "node --test scripts/test-production-audit-upload-admission.cjs",
    "test:remediation-workflow-contract": "node --test scripts/test-remediation-workflow-contract.cjs",
    "test:post-merge-review-remediation": "node --test scripts/test-production-audit-remediation.cjs scripts/test-production-audit-upload-admission.cjs scripts/test-sharp-native-lifecycle.cjs scripts/test-remediation-workflow-contract.cjs",
    "validate:production-audit": "node scripts/validate-production-audit.cjs",
    "validate:production-audit-self-test": "node scripts/validate-production-audit.cjs --self-test",
    "test:admin-access-playwright": "playwright test --config=playwright.admin-access.config.ts",
    "test:public-regression-playwright": "playwright test --config=playwright.public-regression.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "16.2.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
